generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum MatchStatus {
  NS
  LIVE
  HT
  FT
  PST
  CANC
}

model User {
  id          String        @id @default(cuid())
  phone       String        @unique
  name        String
  nickname    String?       @unique
  avatarUrl   String?
  role        UserRole      @default(USER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  predictions Prediction[]
  stats       UserStats?
}

model UserStats {
  userId        String @id
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalPoints   Int    @default(0)
  exactMatches  Int    @default(0)
  winnerHits    Int    @default(0)
  currentStreak Int    @default(0)
  bestStreak    Int    @default(0)
}

model Match {
  id           String      @id @default(cuid())
  fixtureId    Int         @unique
  leagueId     Int
  season       Int
  roundLabel   String
  kickoffUtc   DateTime
  stadium      String?
  venueCity    String?
  status       MatchStatus @default(NS)
  homeTeamId   Int
  homeName     String
  homeLogoUrl  String?
  awayTeamId   Int
  awayName     String
  awayLogoUrl  String?
  homeGoals    Int?
  awayGoals    Int?
  homeStanding Int?
  awayStanding Int?
  homeForm     String?
  awayForm     String?
  oddsHome     Float?
  oddsDraw     Float?
  oddsAway     Float?
  lastSyncedAt DateTime    @default(now())
  predictions  Prediction[]

  @@index([leagueId, season, roundLabel])
  @@index([kickoffUtc])
}

model Prediction {
  id           String    @id @default(cuid())
  userId       String
  matchId      String
  predHome     Int
  predAway     Int
  lockedAt     DateTime?
  pointsEarned Int?
  scoredAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
  @@index([matchId])
}

model StandingRow {
  id          String   @id @default(cuid())
  leagueId    Int
  season      Int
  teamId      Int
  teamName    String
  logoUrl     String?
  rank        Int
  points      Int
  played      Int
  win         Int
  draw        Int
  lose        Int
  goalsDiff   Int
  form        String?
  description String?
  updatedAt   DateTime @updatedAt

  @@unique([leagueId, season, teamId])
  @@index([leagueId, season, rank])
}
