PORT=4000
NODE_ENV=development
# Puerto 5433 en host si usas docker-compose (evita conflicto con Postgres local en :5432)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/quiniela_ligamx?schema=public

JWT_SECRET="cambia-esto-en-produccion-minimo-32-caracteres"

# Admin inicial (teléfono E.164, ej. +528331234567)
ADMIN_BOOTSTRAP_PHONE=

# CORS (Next.js u otros orígenes, separados por coma)
WEB_ORIGIN="http://localhost:3000"

# Contraseña inicial al crear usuarios desde admin (POST /api/v1/admin/users). Mínimo 8 caracteres.
# Los usuarios pueden cambiarla después si añades flujo de “cambiar contraseña” (aún no).
DEFAULT_USER_PASSWORD="cambia-esta-clave-8chars"
